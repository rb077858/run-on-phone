rules_version = '2';

// Run on Phone:
// - The phone app reads projects anonymously, but only by exact code (get), never by
//   listing, so codes can't be enumerated.
// - Only the PC publisher writes, using a service account (which bypasses these rules).
// - onegShabat/*: the public summary of projects/oneg-shabat. Anyone may read it; only the
//   bot's Firebase Auth user may write (the uid is set by projects/oneg-shabat/deploy/setup-firebase.mjs).
service cloud.firestore {
  match /databases/{database}/documents {
    // oneg-shabat:start
    match /onegShabat/{doc} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null && request.auth.uid == "SET_BY_SETUP_SCRIPT";
    }
    // oneg-shabat:end

    match /projects/{code} {
      allow get: if true;
      allow list, write: if false;

      match /chunks/{chunk} {
        allow get: if true;
        allow list, write: if false;
      }
    }
  }
}
